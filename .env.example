# ==== Serveur ====
PORT=8080
# URL publique HTTPS/WSS de ce service (sans slash final). Laisse vide pour la
# deduire des entetes de la requete Twilio (utile derriere un tunnel/proxy).
# Exemple en production: https://ivr.agencebalgio.ca
PUBLIC_BASE_URL=

# ==== Identite de la standardiste ====
BUSINESS_NAME=Balgio
ASSISTANT_NAME=Gio
BUSINESS_TIMEZONE=America/Toronto
# Numero (format E.164) vers lequel transferer un appel a un humain.
HUMAN_TRANSFER_NUMBER=+1XXXXXXXXXX

# ==== Claude (Anthropic) ====
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# Modele rapide recommande pour la voix (faible latence).
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_MAX_TOKENS=1024

# ==== Twenty CRM ====
TWENTY_BASE_URL=https://crm.agencebalgio.ca
# Cle API Twenty (Parametres > API & Webhooks > cle API).
TWENTY_API_KEY=
TWENTY_DEFAULT_COUNTRY=CA

# ==== Twilio ====
# Auth token du compte Twilio, sert a valider la signature des requetes.
TWILIO_AUTH_TOKEN=
VALIDATE_TWILIO_SIGNATURE=true

# ==== ConversationRelay (voix) ====
# fr-CA = francais du Quebec. Voir la doc Twilio pour les voix disponibles.
CR_LANGUAGE=fr-CA
# Fournisseur TTS: Amazon | Google | ElevenLabs (laisse vide = defaut Twilio).
CR_TTS_PROVIDER=Google
# Voix masculine fr-CA. Exemples: Google=fr-CA-Neural2-D, Amazon=Liam-Neural.
CR_VOICE=fr-CA-Neural2-D
# Fournisseur de transcription: Google | Deepgram (laisse vide = defaut Twilio).
CR_TRANSCRIPTION_PROVIDER=Google
CR_SPEECH_MODEL=
CR_INTERRUPTIBLE=true
