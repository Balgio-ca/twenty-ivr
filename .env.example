# ==== Serveur ====
PORT=8080
# URL publique HTTPS/WSS de ce service (sans slash final). Laisse vide pour la
# deduire des entetes de la requete Twilio (utile derriere un tunnel/proxy).
# Exemple en production: https://ivr.agencebalgio.ca
PUBLIC_BASE_URL=

# ==== Identite de la standardiste ====
BUSINESS_NAME=Balgio
ASSISTANT_NAME=Gio
BUSINESS_TIMEZONE=America/Toronto
BUSINESS_MAIN_PHONE=514-447-5205
# Routage des transferts par statut client (format E.164).
# Client actif (a deja eu des factures) -> Mathieu ; nouveau contact -> Alexandre.
TRANSFER_EXISTING_CLIENT=+14389288488
TRANSFER_NEW_CLIENT=+15145716742

# ==== Heures d'ouverture (transfert possible; hors de ces heures = message) ====
BUSINESS_OPEN_HOUR=8
BUSINESS_CLOSE_HOUR=17
BUSINESS_DAYS=Mon,Tue,Wed,Thu,Fri

# ==== Courriel (envoi des messages telephoniques) ====
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
EMAIL_FROM=Gio (Balgio) <gio@balgio.ca>
MESSAGE_EMAIL_TO=mgiosi@balgio.ca

# ==== Claude (Anthropic) ====
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
# Modele rapide recommande pour la voix (faible latence).
ANTHROPIC_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_MAX_TOKENS=1024

# ==== Twenty CRM ====
TWENTY_BASE_URL=https://crm.agencebalgio.ca
# Cle API Twenty (Parametres > API & Webhooks > cle API).
TWENTY_API_KEY=
TWENTY_DEFAULT_COUNTRY=CA

# ==== Twilio ====
# Account SID (commence par AC) - requis pour l'envoi de SMS d'alerte.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Auth token du compte Twilio, sert aux SMS et a valider la signature.
TWILIO_AUTH_TOKEN=
VALIDATE_TWILIO_SIGNATURE=true

# ==== ConversationRelay (voix) ====
# fr-CA = francais du Quebec. Voir la doc Twilio pour les voix disponibles.
CR_LANGUAGE=fr-CA
# Fournisseur TTS: Amazon | Google | ElevenLabs (laisse vide = defaut Twilio).
# Pour une voix plus naturelle: ElevenLabs (necessite d'ajouter ta cle
# ElevenLabs dans la console Twilio) ou Amazon Polly neural.
CR_TTS_PROVIDER=Google
# Voix masculine fr-CA. Exemples:
#   Google=fr-CA-Neural2-D | Amazon=Liam-Neural | ElevenLabs=<voice_id>
CR_VOICE=fr-CA-Neural2-D
# Fournisseur de transcription: Google | Deepgram (laisse vide = defaut Twilio).
CR_TRANSCRIPTION_PROVIDER=Google
CR_SPEECH_MODEL=
CR_INTERRUPTIBLE=true
